generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  identities    ChannelIdentity[]
  linkCodes     LinkCode[]
  agentSessions AgentSession[]
  profile       UserProfile?
  meals         Meal[]
  reminders     MealReminder[]
  goals         UserGoal[]
  conversationMessages ConversationMessage[]
  catalogProducts CatalogProduct[]
  productFavorites ProductFavorite[]
  agentTurns    AgentTurn[]
  pendingAcks   AgentTurnPendingAck[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model ChannelIdentity {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  threadId       String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model LinkCode {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AgentSession {
  eveSessionId String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CatalogProduct {
  barcode         String   @id
  name            String
  brands          String?
  quantity        String?
  servingSize     String?
  nutriments      Json
  searchText      String   @default(dbgenerated("lower(immutable_unaccent(TRIM(BOTH FROM COALESCE(\"name\", '') || ' ' || COALESCE(\"brands\", ''))))"))
  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdByUserId])
  @@index([name])
}

model OffProduct {
  barcode         String    @id
  name            String?
  names           Json
  brands          String?
  quantity        String?
  servingSize     String?
  nutriscoreGrade String?
  novaGroup       Int?
  ingredients     String?   @db.Text
  allergens       String?
  nutriments      Json
  imageUrl        String?
  countryCodes    String[]
  searchSource    String    @db.Text
  searchText      String    @default(dbgenerated("lower(immutable_unaccent(COALESCE(\"searchSource\", '')))"))
  lastModifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OffImportState {
  id               String    @id @default("default")
  lastDeltaFile    String?
  lastFullImportAt DateTime?
  countryCodes     String[]
  updatedAt        DateTime  @updatedAt
}

enum AgentTurnStatus {
  running
  completed
  failed
  cancelled
}

model AgentTurn {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId        String
  turnId           String
  turnSequence     Int
  channel          String
  status           AgentTurnStatus @default(running)
  model            String?
  startedAt        DateTime
  endedAt          DateTime?
  durationMs       Int?
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  cacheReadTokens  Int             @default(0)
  cacheWriteTokens Int             @default(0)
  costUsd          Decimal         @default(0) @db.Decimal(12, 6)
  errorCode        String?
  errorMessage     String?
  userPreview      String?         @db.Text
  messages         Json
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([sessionId, turnId])
  @@index([startedAt])
  @@index([userId, startedAt])
  @@index([sessionId, turnSequence])
  @@index([channel, startedAt])
}

model AgentTurnPendingAck {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          String
  text             String?  @db.Text
  model            String?
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  sessionId        String?
  turnId           String?
  createdAt        DateTime @default(now())

  @@index([userId, channel, createdAt])
  @@index([sessionId, turnId])
}

model ConversationMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  sessionId String
  role      String
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, channel, createdAt])
}

model MemoryDocument {
  userId    String
  slot      String   @default("profile")
  scopeKey  String?
  content   String   @default("{\"lastAllocatedIndex\":-1,\"entries\":[]}")
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, slot])
}

model UserProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     String   @default("")
  country   String?
  locale    String?
  timezone  String?
  updatedAt DateTime @updatedAt
}

enum GoalKind {
  calories_per_day
  protein_g_per_day
  carbs_g_per_day
  fat_g_per_day
  fiber_g_per_day
}

model UserGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      GoalKind
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
  @@index([userId])
}

enum MealLabel {
  breakfast
  lunch
  dinner
  snack
  other
}

enum ReminderLabel {
  breakfast
  lunch
  dinner
  summary
}

enum MealItemUnit {
  g
  ml
  serving
}

model MealReminder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       ReminderLabel
  enabled     Boolean   @default(true)
  hour        Int
  minute      Int       @default(0)
  nextRunAt   DateTime  @db.Timestamptz
  leaseUntil  DateTime? @db.Timestamptz
  leaseToken  String?
  lastFiredAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, label])
  @@index([enabled, nextRunAt])
}

model Meal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt   DateTime   @db.Timestamptz
  label     MealLabel
  items     MealItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, eatenAt])
}

model MealItem {
  id                String       @id @default(cuid())
  mealId            String
  meal              Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name              String
  barcode           String?
  amount            Float
  unit              MealItemUnit
  grams             Float
  nutrimentsPer100g Json
  energyKcal        Float?
  proteins          Float?
  carbohydrates     Float?
  sugars            Float?
  fat               Float?
  saturatedFat      Float?
  fiber             Float?
  salt              Float?
  imageUrl          String?
  createdAt         DateTime     @default(now())

  @@index([mealId])
}

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  barcode   String?
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model ChatSdkEntry {
  key       String    @id
  value     Json
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
}
