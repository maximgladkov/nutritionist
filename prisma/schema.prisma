generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  identities    ChannelIdentity[]
  linkCodes     LinkCode[]
  agentSessions AgentSession[]
  assistantActions AssistantAction[]
  profile       UserProfile?
  meals         Meal[]
  reminders     MealReminder[]
  goals         UserGoal[]
  conversationMessages ConversationMessage[]
  catalogProducts CatalogProduct[]
  productFavorites ProductFavorite[]
  agentTurns    AgentTurn[]
  pendingAcks   AgentTurnPendingAck[]
  attachments   UserAttachment[]
  ownedGroups   Group[]          @relation("OwnedGroups")
  groupMemberships GroupMember[]
  groupMessagesSent     GroupMessage[] @relation("GroupMessagesSent")
  groupMessagesReceived GroupMessage[] @relation("GroupMessagesReceived")
  groupNoticesAuthored  GroupNotice[]  @relation("GroupNoticesAuthored")
  groupInvitesCreated   GroupInvite[]  @relation("GroupInvitesCreated")
  groupInvitesUsed      GroupInvite[]  @relation("GroupInvitesUsed")
  refreshTokens RefreshToken[]
  pushDevices   PushDevice[]
  savedMeals    SavedMeal[]
  mealShares    MealShare[]
  weightEntries WeightEntry[]
  dailyActivity DailyActivity[]
  fatSecretConnection FatSecretConnection?
  externalImports ExternalImport[]
  progressPhotos ProgressPhoto[]
  achievements  UserAchievement[]
  achievementEvents AchievementEvent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model ChannelIdentity {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  threadId       String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model LinkCode {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AgentSession {
  eveSessionId String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// Something the app's assistant showed or did in a conversation, kept beside the transcript: a meal
// it logged (which can be undone), a meal idea waiting for a tap, a voice note, the day's greeting.
model AssistantAction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  // The tool call it belongs to; for a greeting or voice note, its own key.
  callId      String
  kind        String
  state       String   @default("open")
  payload     Json
  mealItemIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, callId])
  @@index([userId, createdAt])
}

model CatalogProduct {
  id              String   @id @default(cuid())
  barcode         String?  @unique
  name            String
  brands          String?
  quantity        String?
  servingSize     String?
  nutriments      Json
  searchText      String   @default(dbgenerated("lower(immutable_unaccent(TRIM(BOTH FROM COALESCE(\"name\", '') || ' ' || COALESCE(\"brands\", ''))))"))
  // Meaning-based search vector (see lib/product-embeddings.ts); null until embedded.
  embedding       Unsupported("vector(768)")?
  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  images          CatalogProductImage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdByUserId])
  @@index([name])
}

model UserAttachment {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String
  turnId        String
  channel       String
  filename      String?
  mediaType     String
  size          Int?
  blobUrl       String
  blobPath      String   @unique
  createdAt     DateTime @default(now())
  catalogImages CatalogProductImage[]
  mealPhotos    MealPhoto[]
  progressPhotos ProgressPhoto[]
  avatarOf      UserProfile?

  @@index([sessionId, turnId])
  @@index([userId])
}

enum CatalogProductImageKind {
  front
  nutrition
  other
}

model CatalogProductImage {
  id           String                   @id @default(cuid())
  productId    String
  product      CatalogProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   UserAttachment           @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  kind         CatalogProductImageKind
  sortOrder    Int
  createdAt    DateTime                 @default(now())

  @@unique([productId, attachmentId])
  @@index([productId, sortOrder])
}

model OffProduct {
  barcode         String    @id
  name            String?
  names           Json
  brands          String?
  quantity        String?
  servingSize     String?
  nutriscoreGrade String?
  novaGroup       Int?
  ingredients     String?   @db.Text
  allergens       String?
  nutriments      Json
  imageUrl        String?
  countryCodes    String[]
  searchSource    String    @db.Text
  searchText      String    @default(dbgenerated("lower(immutable_unaccent(COALESCE(\"searchSource\", '')))"))
  // Meaning-based search vector (see lib/product-embeddings.ts); null until embedded.
  embedding       Unsupported("vector(768)")?
  lastModifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OffImportState {
  id               String    @id @default("default")
  lastDeltaFile    String?
  lastFullImportAt DateTime?
  countryCodes     String[]
  updatedAt        DateTime  @updatedAt
}

enum AgentTurnStatus {
  running
  completed
  failed
  cancelled
}

model AgentTurn {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId        String
  turnId           String
  turnSequence     Int
  channel          String
  status           AgentTurnStatus @default(running)
  model            String?
  startedAt        DateTime
  endedAt          DateTime?
  durationMs       Int?
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  cacheReadTokens  Int             @default(0)
  cacheWriteTokens Int             @default(0)
  costUsd          Decimal         @default(0) @db.Decimal(12, 6)
  errorCode        String?
  errorMessage     String?
  userPreview      String?         @db.Text
  messages         Json
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([sessionId, turnId])
  @@index([startedAt])
  @@index([userId, startedAt])
  @@index([sessionId, turnSequence])
  @@index([channel, startedAt])
}

model AgentTurnPendingAck {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          String
  text             String?  @db.Text
  model            String?
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  sessionId        String?
  turnId           String?
  createdAt        DateTime @default(now())

  @@index([userId, channel, createdAt])
  @@index([sessionId, turnId])
}

model ConversationMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  sessionId String
  role      String
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, channel, createdAt])
}

model MemoryDocument {
  userId    String
  slot      String   @default("profile")
  scopeKey  String?
  content   String   @default("{\"lastAllocatedIndex\":-1,\"entries\":[]}")
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, slot])
}

model UserProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     String   @default("")
  country   String?
  locale    String?
  timezone  String?
  // Only the person sees these. Gender is one of PROFILE_GENDERS (lib/profile.ts); the birth date is
  // YYYY-MM-DD, so an age never goes stale.
  gender    String?
  birthDate String?
  heightCm  Float?
  // The profile photo: an upload already cropped to a square. See canSeeAvatar for who may load it.
  avatarId  String?  @unique
  avatar    UserAttachment? @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  // Details the person set or cleared themselves ("heightCm"), which are never filled in for them.
  settledFields String[] @default([])
  startWeightKg Float?
  goalWeightKg  Float?
  notificationsReadAt DateTime?
  // App preferences that follow the person across devices (nutrient order, ...).
  preferences Json @default("{}")
  updatedAt DateTime @updatedAt
}

enum GoalKind {
  calories_per_day
  protein_g_per_day
  carbs_g_per_day
  fat_g_per_day
  fiber_g_per_day
}

model UserGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      GoalKind
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
  @@index([userId])
}

enum MealLabel {
  breakfast
  lunch
  dinner
  snack
  other
}

enum ReminderLabel {
  breakfast
  lunch
  dinner
  summary
}

enum MealItemUnit {
  g
  ml
  serving
}

model MealReminder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       ReminderLabel
  enabled     Boolean   @default(true)
  hour        Int
  minute      Int       @default(0)
  nextRunAt   DateTime  @db.Timestamptz
  leaseUntil  DateTime? @db.Timestamptz
  leaseToken  String?
  lastFiredAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, label])
  @@index([enabled, nextRunAt])
}

model Meal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt   DateTime   @db.Timestamptz
  label     MealLabel
  items     MealItem[]
  photos    MealPhoto[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, eatenAt])
}

model MealItem {
  id                String       @id @default(cuid())
  mealId            String
  meal              Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name              String
  brand             String?
  barcode           String?
  amount            Float
  unit              MealItemUnit
  grams             Float
  // The serving the person picked when logging ("slices (30 g)"), so the food reopens in it and
  // a shared copy offers it; null when logged in grams or millilitres.
  servingLabel      String?
  servingGrams      Float?
  nutrimentsPer100g Json
  energyKcal        Float?
  proteins          Float?
  carbohydrates     Float?
  sugars            Float?
  fat               Float?
  saturatedFat      Float?
  fiber             Float?
  salt              Float?
  imageUrl          String?
  createdAt         DateTime     @default(now())

  @@index([mealId])
}

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  barcode   String?
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model ChatSdkEntry {
  key       String    @id
  value     Json
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
}

// What a group's owner sees of a sharing member: daily totals and goals, the foods they logged,
// their meal photos, their weight log, and Apple Health activity.
enum GroupShareKind {
  summary
  meals
  photos
  weight
  activity
}

enum GroupMemberRole {
  owner
  member
}

model Group {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation("OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String   @default("")
  imageUrl      String
  imageBlobPath String
  inviteToken   String   @unique
  // Short code people type in the app ("LEAN-7K2P"); rotates with the invite link.
  joinCode      String?  @unique
  // Shown under the owner's name to members ("Nutritionist").
  ownerTitle    String   @default("")
  // When false, members see neither the member list nor each other; only the owner does.
  membersVisible Boolean @default(true)
  // What members who share their diary show the owner.
  shares        GroupShareKind[] @default([summary, meals, photos, activity])
  locale        String   @default("en")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       GroupMember[]
  messages      GroupMessage[]
  notices       GroupNotice[]
  invites       GroupInvite[]

  @@index([ownerId])
}

model GroupMember {
  id       String          @id @default(cuid())
  groupId  String
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole
  sharing  Boolean         @default(true)
  lastReadAt DateTime?
  noticesReadAt DateTime?
  // What this member agreed to show the owner, from the group's list. The owner sees the overlap
  // of the two, so adding to the group's list needs each member's yes.
  allowedShares  GroupShareKind[] @default([])
  // Items the member has answered (allowed or declined); the rest of the group's list is an ask.
  answeredShares GroupShareKind[] @default([])
  joinedAt DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("GroupMessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("GroupMessagesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  targetDate String?
  targetMealItemId String?
  // Replies point at the thread's first message and share its target.
  replyToId  String?
  replyTo    GroupMessage?  @relation("GroupMessageReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies    GroupMessage[] @relation("GroupMessageReplies")
  // Set when the member marks the coach's comment as helpful.
  helpfulAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([groupId, toUserId, createdAt])
  @@index([replyToId])
  @@index([toUserId, createdAt])
  @@index([fromUserId])
}

// A personal invite: a code and link for one person, which stop working once someone joins with
// them (or the owner revokes them). The group's own code and link stay reusable.
model GroupInvite {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("GroupInvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  code        String    @unique
  token       String    @unique
  // Who it's for, as the owner wrote it ("Kira"), so they can tell invites apart.
  note        String    @default("")
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("GroupInvitesUsed", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([groupId, createdAt])
  @@index([createdById])
  @@index([usedById])
}

// A post from the group owner that every member sees.
model GroupNotice {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("GroupNoticesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, createdAt])
  @@index([authorId])
}

model TelegramInboundBurstItem {
  id           String    @id @default(cuid())
  chatId       String
  messageId    String
  text         String    @default("")
  caption      String    @default("")
  attachments  Json
  mediaGroupId String?
  createdAt    DateTime  @default(now())
  consumedAt   DateTime?

  @@unique([chatId, messageId])
  @@index([chatId, consumedAt, createdAt])
}

// Mobile API: rotating refresh tokens. Only a SHA-256 hash of each token is stored.
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  deviceName  String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@index([userId])
}

// Mobile API: one-time email sign-in codes. Only a hash of each code is stored.
model EmailLoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SavedMeal {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     SavedMealItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
}

model SavedMealItem {
  id                String       @id @default(cuid())
  savedMealId       String
  savedMeal         SavedMeal    @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  sortOrder         Int
  name              String
  brand             String?
  barcode           String?
  amount            Float
  unit              MealItemUnit
  nutrimentsPer100g Json

  @@index([savedMealId, sortOrder])
}

// A meal someone shared: a copy of its foods at the time, behind an unguessable token, so the
// person they send the link to can add the same foods to their own diary.
model MealShare {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     MealLabel
  // [{ name, brand, barcode, amount, unit, nutrimentsPer100g }]
  items     Json
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MealPhoto {
  id           String         @id @default(cuid())
  mealId       String
  meal         Meal           @relation(fields: [mealId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   UserAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  // Where it sits among the meal's photos, from 0; people reorder them by dragging.
  position     Int            @default(0)
  createdAt    DateTime       @default(now())

  @@unique([mealId, attachmentId])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  weightKg  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model ProgressPhoto {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   UserAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  date         String
  createdAt    DateTime       @default(now())

  @@index([userId, date])
}

// Generic foods from reference tables (USDA FoodData Central SR Legacy): plain foods such as a
// fried egg, toast or brewed coffee that the packaged-product catalog doesn't cover.
model GenericFood {
  id         String   @id
  source     String
  sourceId   String
  name       String
  category   String?
  // Per-100 g values, keyed like product nutriments (energyKcal100g, proteins100g, …).
  nutriments Json
  // Household portions: [{ label: "1 large", grams: 46 }].
  portions   Json
  searchText String   @default(dbgenerated("lower(immutable_unaccent(TRIM(BOTH FROM COALESCE(\"name\", '') || ' ' || COALESCE(\"category\", ''))))"))
  // Meaning-based search vector (see lib/product-embeddings.ts); null until embedded.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, sourceId])
}

// A user's link to their FatSecret account (OAuth 1.0) and the state of their diary import.
// Tokens are sealed with AUTH_SECRET (lib/secret-box.ts) before they are stored.
model FatSecretConnection {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // pending: sign-in started, waiting for FatSecret to send the user back; connected: tokens stored.
  status           String    @default("pending")
  requestToken     String?   @unique
  requestSecret    String?
  returnUrl        String?
  accessToken      String?
  accessSecret     String?
  // idle | running | done | failed
  importStatus     String    @default("idle")
  // The month being imported (YYYY-MM), so the app can show how far back it has got.
  importMonth      String?
  importMonthsDone Int       @default(0)
  importedEntries  Int       @default(0)
  importedDays     Int       @default(0)
  importedWeights  Int       @default(0)
  importOldestDate String?
  importError      String?
  importStartedAt  DateTime?
  importFinishedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Entries already brought in from another app, so importing again never duplicates them (and
// doesn't bring back ones the user deleted here).
model ExternalImport {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String
  externalId String
  createdAt  DateTime @default(now())

  @@id([userId, source, externalId])
}

// Activity for a day from the user's phone (Apple Health): active calories burned and steps.
// Either may be missing when the user doesn't share it.
model DailyActivity {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  activeKcal Float?
  steps      Int?
  updatedAt  DateTime @updatedAt

  @@id([userId, date])
}

// A badge earned, with the day it was earned on. Kept for good, even when the numbers behind it
// change later (a meal is deleted, a goal is raised). Ids come from lib/achievements/catalog.ts.
model UserAchievement {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  earnedOn      String
  createdAt     DateTime @default(now())

  @@id([userId, achievementId])
}

// The first time someone did something that leaves no other trace (a barcode scan, a voice note),
// for the "Firsts" badges. See lib/achievements/events.ts.
model AchievementEvent {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@id([userId, kind])
}
